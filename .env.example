# Copy to .env.local for development, or add these in Vercel Project > Settings > Environment Variables.
# Leave the Supabase and AI fields empty for the working local preview.
NEXT_PUBLIC_SITE_URL=https://cellula.in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The optional Cloudflare Turnstile public site key used by the sign-in form.
# If used, set the secret in Supabase Auth's CAPTCHA settings, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only. Never add NEXT_PUBLIC_ to these or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
CHAT_SIGNING_SECRET=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Use max_completion_tokens instead if your provider requires it.
AI_TOKEN_PARAMETER=max_tokens
# Daily cap on live provider request attempts, not on student lifetime messages.
CHAT_DAILY_REQUESTS=1000
